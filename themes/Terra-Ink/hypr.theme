$HOME/.config/hypr/themes/theme.conf|> $HOME/.config/hypr/themes/colors.conf
$GTK_THEME = Gruvbox-Retro
$ICON_THEME = Gruvbox-Plus-Dark
$COLOR_SCHEME = prefer-dark

exec = gsettings set org.gnome.desktop.interface icon-theme $ICON_THEME
exec = gsettings set org.gnome.desktop.interface gtk-theme $GTK_THEME
exec = gsettings set org.gnome.desktop.interface color-scheme $COLOR_SCHEME
exec = $HOME/.config/hyde/themes/Terra-Ink/terra-engine.sh

general {
    gaps_in = 6
    gaps_out = 12
    border_size = 2
    col.active_border = rgba(DFA04Bff) rgba(D46A38ff) rgba(DFA04Bff) 45deg
    col.inactive_border = rgba(3A2E26aa)
    layout = dwindle
}

decoration {
    rounding = 14
    active_opacity = 0.92
    inactive_opacity = 0.84

    blur {
        enabled = true
        size = 8
        passes = 4
        new_optimizations = true
        ignore_opacity = true
        xray = false
        vibrancy = 0.25
    }

    shadow {
        enabled = true
        range = 24
        render_power = 3
        color = rgba(0D0907bb)
    }
}

# Animaciones fluidas Pro
animations {
    enabled = yes
    bezier = fluid, 0.16, 1, 0.3, 1
    bezier = spring, 0.05, 0.9, 0.1, 1.05
    bezier = liner, 1, 1, 1, 1

    animation = windowsIn, 1, 5, spring, popin 82%
    animation = windowsOut, 1, 4, fluid, popin 85%
    animation = windowsMove, 1, 5, spring, slide
    animation = border, 1, 8, default
    animation = borderangle, 1, 40, liner, loop
    animation = fade, 1, 5, fluid
    animation = workspaces, 1, 6, fluid, slidefade 20%
}

layerrule = blur, waybar
layerrule = ignorezero, waybar
layerrule = blur, rofi
layerrule = ignorezero, rofi
